# Keep your real key in .env, never in the browser or Git.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=3000

# Required on Vercel. Create a Turso/libSQL database and copy its URL and token.
# Leave these unset to use local SQLite during development.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# APP_PASSWORD=
